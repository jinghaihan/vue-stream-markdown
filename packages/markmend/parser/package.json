{
  "name": "@markmend/parser",
  "type": "module",
  "version": "1.1.0",
  "description": "Streaming Markdown parsing powered by Markmend and Comark.",
  "author": "jinghaihan",
  "license": "MIT",
  "homepage": "https://github.com/jinghaihan/vue-stream-markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinghaihan/vue-stream-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/jinghaihan/vue-stream-markdown/issues"
  },
  "keywords": [
    "markdown",
    "stream",
    "parser",
    "comark"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "comark": "catalog:parser",
    "markdown-it-cjk-friendly": "catalog:parser",
    "@markmend/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:build"
  },
  "inlinedDependencies": {
    "comark": "0.6.2",
    "entities": [
      "7.0.1",
      "8.0.0"
    ],
    "get-east-asian-width": "1.6.0",
    "htmlparser2": "12.0.0",
    "js-yaml": "5.4.1",
    "katex": "0.16.47",
    "linkify-it": "5.0.2",
    "markdown-exit": "1.1.0-beta.2",
    "markdown-it-cjk-friendly": "3.0.0",
    "mdurl": "2.1.0",
    "punycode.js": "2.3.1",
    "uc.micro": "2.1.0"
  }
}
